rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check from server-only collection
    function isCoach() {
      return isAuthenticated() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function isClubStaffOf(athleteId) {
      let athlete = get(/databases/$(database)/documents/users/$(athleteId)).data;
      return isCoach() && 
        athlete.clubId != null &&
        request.auth.uid in get(/databases/$(database)/documents/clubs/$(athlete.clubId)).data.staffIds;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isClubStaffOf(userId) || isCoach();
      // Users cannot change their own role or clubId
      allow write: if isOwner(userId) && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.clubId == resource.data.clubId;

      match /chatThreads/{threadId} {
        allow read, write: if isOwner(userId) || isClubStaffOf(userId);
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) || isClubStaffOf(userId);
        }
      }
      match /videoAnalyses/{analysisId} {
        allow read, write: if isOwner(userId) || isClubStaffOf(userId);
      }
      match /files/{fileId} {
        allow read, write: if isOwner(userId) || isClubStaffOf(userId);
      }
    }

    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      // Club write allow only if owner or staff
      allow write: if isAuthenticated() && 
        (request.auth.uid == resource.data.ownerCoachId || request.auth.uid in resource.data.staffIds);
    }

    // Periodization: Only staff can write
    match /athletePeriodizationPlans/{athleteId} {
      allow read: if isOwner(athleteId) || isClubStaffOf(athleteId);
      allow write: if isClubStaffOf(athleteId);
    }

    match /competitionCalendar/{athleteId} {
      allow read: if isOwner(athleteId) || isClubStaffOf(athleteId);
      allow write: if isClubStaffOf(athleteId);
    }

    match /inferredTrainingContext/{athleteId} {
      allow read: if isOwner(athleteId) || isClubStaffOf(athleteId);
      allow write: if false;
    }

    match /scientificEvidence/{evidenceId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    match /eventReferenceStandards/{standardId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }
  }
}
