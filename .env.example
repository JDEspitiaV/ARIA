# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Firebase configuration
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Scientific Literature & Media APIs (Optional Server-Side Keys)
CORE_API_KEY=
YOUTUBE_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# Cloudinary Storage (Free Tier Server-Side Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ARIA Tres Poderes Architecture
# 1. Poder Judicial (DeepSeek-R1)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. Poder Legislativo (Supabase + pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Observabilidad & Logging (Axiom)
AXIOM_TOKEN=
AXIOM_DATASET=aria-errors

# 4. Caché de protocolos & precedentes (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
