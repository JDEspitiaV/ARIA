# LLM Provider Configuration (Server-side OpenAI-compatible API)
# LLM_API_KEY is required and will cause server to fail fast at boot if missing.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Firebase configuration (Client & Server)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Scientific Literature & Media APIs (Optional Server-Side Keys)
CORE_API_KEY=
YOUTUBE_API_KEY=
CROSSREF_MAILTO=
UNPAYWALL_EMAIL=

# Cloudinary Storage (Server-Side Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ARIA Architecture Integrations
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AXIOM_TOKEN=
AXIOM_DATASET=aria-errors
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server Security
CRON_SECRET= # Required for /api/cron routes
