{
  "entities": {
    "Athlete": {
      "title": "Athlete",
      "description": "Athlete profile with verified PBs, anthropometrics, target events, and active kinetic chain deficiencies",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "targetEvents": { "type": "array" },
        "personalBests": { "type": "object" },
        "activeInjuries": { "type": "array" },
        "kineticDeficiencies": { "type": "array" },
        "onboardingComplete": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "heightCm", "weightKg"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Sequential chat log message in the ARIA conversational interface",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "ScientificEvidence": {
      "title": "ScientificEvidence",
      "description": "Peer-reviewed literature item cached with domain and refresh cycle metadata",
      "type": "object",
      "properties": {
        "domain": { "type": "string", "enum": ["performance", "longevity", "skeletal"] },
        "query": { "type": "string" },
        "source": { "type": "string" },
        "title": { "type": "string" },
        "doi": { "type": "string" },
        "abstract": { "type": "string" },
        "url": { "type": "string" },
        "fetchedAt": { "type": "string" },
        "refreshCycle": { "type": "string", "enum": ["performance", "monthly-independent"] }
      },
      "required": ["domain", "query", "source", "title"]
    },
    "EventReferenceStandard": {
      "title": "EventReferenceStandard",
      "description": "Curated technical benchmarks, kinematic models, and biomechanical parameters per track and field discipline",
      "type": "object",
      "properties": {
        "eventName": { "type": "string" },
        "lastUpdatedByCoach": { "type": "string" },
        "content": { "type": "string" },
        "sourceFile": { "type": "string" }
      },
      "required": ["eventName", "content"]
    },
    "AthletePeriodizationPlan": {
      "title": "AthletePeriodizationPlan",
      "description": "Annual periodization plan with macrocycle and mesocycles",
      "type": "object",
      "properties": {
        "athleteId": { "type": "string" },
        "season": { "type": "string" },
        "createdBy": { "type": "string", "enum": ["athlete", "coach", "staff"] },
        "lastUpdated": { "type": "string" },
        "macrocycle": { "type": "object" },
        "mesocycles": { "type": "array" }
      },
      "required": ["athleteId", "season", "macrocycle", "mesocycles"]
    },
    "CompetitionCalendar": {
      "title": "CompetitionCalendar",
      "description": "Competition calendar with priorities and taper dates",
      "type": "object",
      "properties": {
        "athleteId": { "type": "string" },
        "competitions": { "type": "array" }
      },
      "required": ["athleteId", "competitions"]
    },
    "Club": {
      "title": "Club",
      "description": "Athletic track club with coaching staff and member athletes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerCoachId": { "type": "string" },
        "joinCode": { "type": "string" },
        "staffIds": { "type": "array", "items": { "type": "string" } },
        "memberAthleteIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "ownerCoachId", "joinCode", "staffIds", "memberAthleteIds"]
    },
    "InferredTrainingContext": {
      "title": "InferredTrainingContext",
      "description": "Conversationally inferred training phase and competition proximity for unaffiliated athletes",
      "type": "object",
      "properties": {
        "athleteId": { "type": "string" },
        "currentPhase": { "type": "string" },
        "proximityToCompetition": { "type": "string" },
        "notes": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["athleteId", "currentPhase"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Conversation thread session for athlete",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messageCount": { "type": "number" },
        "lastMessagePreview": { "type": "string" },
        "keyFactSummary": { "type": "string" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/Athlete" },
      "description": "User profile store"
    },
    "/users/{userId}/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Chat conversation thread session"
    },
    "/users/{userId}/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages within a thread session"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat conversation messages for user"
    },
    "/clubs/{clubId}": {
      "schema": { "$ref": "#/entities/Club" },
      "description": "Track clubs with coach staff and member athletes"
    },
    "/scientificEvidence/{evidenceId}": {
      "schema": { "$ref": "#/entities/ScientificEvidence" },
      "description": "Auto-refreshed scientific evidence repository"
    },
    "/eventReferenceStandards/{standardId}": {
      "schema": { "$ref": "#/entities/EventReferenceStandard" },
      "description": "Curated event reference standards and kinematic benchmarks"
    },
    "/athletePeriodizationPlans/{athleteId}": {
      "schema": { "$ref": "#/entities/AthletePeriodizationPlan" },
      "description": "Annual periodization and training load plan for athlete"
    },
    "/competitionCalendar/{athleteId}": {
      "schema": { "$ref": "#/entities/CompetitionCalendar" },
      "description": "Scheduled competitions and taper tracking for athlete"
    },
    "/inferredTrainingContext/{athleteId}": {
      "schema": { "$ref": "#/entities/InferredTrainingContext" },
      "description": "Server-inferred training phase from chat for unaffiliated athletes"
    }
  }
}
